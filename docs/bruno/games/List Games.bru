meta {
  name: List Games
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/games?page=0&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/games?page=0&size=10
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      x-content-type-options: nosniff
      x-xss-protection: 0
      cache-control: no-cache, no-store, max-age=0, must-revalidate
