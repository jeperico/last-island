      content-type: application/json
      content-length: 216
      date: Tue, 30 Jun 2026 21:43:42 GMT
      keep-alive: timeout=60
      connection: keep-alive
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "content": [
            {
