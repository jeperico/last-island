meta {
  name: Place Ships (Pirate)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/games/{{gameToken}}/place-ships
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "ships": [
      { "type": "THOUSAND_SUNNY", "orientation": "HORIZONTAL", "row": 0, "col": 0 },
      { "type": "MOBY_DICK", "orientation": "HORIZONTAL", "row": 2, "col": 0 },
      { "type": "RED_FORCE", "orientation": "VERTICAL", "row": 4, "col": 0 },
      { "type": "POLAR_TANG", "orientation": "VERTICAL", "row": 4, "col": 2 },
      { "type": "GOING_MERRY", "orientation": "HORIZONTAL", "row": 8, "col": 0 }
    ]
  }
}
