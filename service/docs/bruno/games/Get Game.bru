meta {
  name: Get Game State
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/games/{{gameToken}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns the full game state from the requesting player's perspective.
  - myBoard: your ships + shots received (opponent's attacks on you)
  - opponentBoard: only your shots fired (fog of war — no ship positions)
}
