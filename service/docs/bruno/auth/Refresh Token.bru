meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

example {
  name: luffy-example
  
  request: {
    url: {{baseUrl}}/api/v1/auth/refresh
    method: POST
    mode: json
    body:json: {
      {
        "refreshToken": "{{refreshToken}}"
      }
    }
  }
  
